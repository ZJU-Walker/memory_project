+    config_zero = dataclasses.replace(config, memory_grad_clip=0.0)
+    new_zero, info_zero = train.train_step(config_zero, rng, state, batch)
+    assert float(info_zero["memory_grad_norm"]) > 0.0
+    kernel_moments = memory_moments = 0
